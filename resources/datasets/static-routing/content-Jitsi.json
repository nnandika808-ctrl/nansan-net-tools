{
  "application": "Jitsi",
  "mode": "content",
  "commands": [
    {
      "path": "/ip firewall raw",
      "operation": "remove",
      "selector": {
        "address-list": "Mikrotik-Jitsi"
      }
    },
    {
      "path": "/ip firewall raw",
      "operation": "add",
      "fields": {
        "action": "add-dst-to-address-list",
        "address-list": "Mikrotik-Jitsi",
        "address-list-timeout": "1d",
        "chain": "prerouting",
        "content": "jitsi.org",
        "dst-address-list": "!LOCAL-IP",
        "src-address-list": "LOCAL-IP"
      }
    },
    {
      "path": "/ip firewall raw",
      "operation": "add",
      "fields": {
        "action": "add-dst-to-address-list",
        "address-list": "Mikrotik-Jitsi",
        "address-list-timeout": "1d",
        "chain": "prerouting",
        "content": ".jitsi.",
        "dst-address-list": "!LOCAL-IP",
        "src-address-list": "LOCAL-IP"
      }
    },
    {
      "path": "/ip firewall address-list",
      "operation": "remove",
      "selector": {
        "list": "Mikrotik-Jitsi"
      }
    }
  ]
