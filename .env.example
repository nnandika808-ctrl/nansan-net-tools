APP_NAME="NANSAN NET Tools"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://mikrotik.nansannet.cloud
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nansan_tools
DB_USERNAME=nansan_tools
DB_PASSWORD=
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=mikrotik.nansannet.cloud
SITE_INDEXABLE=false
CONTACT_URL=
BACKUP_DISK=
BACKUP_ROOT=
BACKUP_ENCRYPTION_KEY=
BACKUP_RETENTION_DAYS=14
RESTORE_MYSQL_HOST=
RESTORE_MYSQL_PORT=3306
RESTORE_MYSQL_USERNAME=
RESTORE_MYSQL_PASSWORD=
MYSQL_CLIENT_PATH=mysql
MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
